{
  "name": "@pdex/sdk",
  "version": "0.6.2",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Public TypeScript SDK for integrating with the PDex V2 protocol",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "LICENSE",
    "BACKEND_INTEGRATION.md",
    "dist/src",
    "INTEGRATION_GUIDE.md",
    "PUBLIC_API.md",
    "QUICKSTART.md",
    "README.md",
    "package.json"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./api": {
      "types": "./dist/src/api.d.ts",
      "import": "./dist/src/api.js"
    },
    "./boxes": {
      "types": "./dist/src/boxes.d.ts",
      "import": "./dist/src/boxes.js"
    },
    "./codec": {
      "types": "./dist/src/codec.d.ts",
      "import": "./dist/src/codec.js"
    },
    "./constants": {
      "types": "./dist/src/constants.d.ts",
      "import": "./dist/src/constants.js"
    },
    "./externalYield": {
      "types": "./dist/src/externalYield.d.ts",
      "import": "./dist/src/externalYield.js"
    },
    "./manifest": {
      "types": "./dist/src/manifest.d.ts",
      "import": "./dist/src/manifest.js"
    },
    "./marketYield": {
      "types": "./dist/src/marketYield.d.ts",
      "import": "./dist/src/marketYield.js"
    },
    "./oracle": {
      "types": "./dist/src/oracle.d.ts",
      "import": "./dist/src/oracle.js"
    },
    "./orderLifecycle": {
      "types": "./dist/src/orderLifecycle.d.ts",
      "import": "./dist/src/orderLifecycle.js"
    },
    "./orders": {
      "types": "./dist/src/orders.d.ts",
      "import": "./dist/src/orders.js"
    },
    "./planners": {
      "types": "./dist/src/planners.d.ts",
      "import": "./dist/src/planners.js"
    },
    "./receipts": {
      "types": "./dist/src/receipts.d.ts",
      "import": "./dist/src/receipts.js"
    },
    "./readModels": {
      "types": "./dist/src/readModels.d.ts",
      "import": "./dist/src/readModels.js"
    },
    "./integration": {
      "types": "./dist/src/integration.d.ts",
      "import": "./dist/src/integration.js"
    },
    "./testFunds": {
      "types": "./dist/src/testFunds.d.ts",
      "import": "./dist/src/testFunds.js"
    },
    "./transactions": {
      "types": "./dist/src/transactions.d.ts",
      "import": "./dist/src/transactions.js"
    },
    "./v2OrderQuotes": {
      "types": "./dist/src/v2OrderQuotes.d.ts",
      "import": "./dist/src/v2OrderQuotes.js"
    },
    "./v2PositionResolution": {
      "types": "./dist/src/v2PositionResolution.d.ts",
      "import": "./dist/src/v2PositionResolution.js"
    },
    "./v2Quotes": {
      "types": "./dist/src/v2Quotes.d.ts",
      "import": "./dist/src/v2Quotes.js"
    },
    "./v2Risk": {
      "types": "./dist/src/v2Risk.d.ts",
      "import": "./dist/src/v2Risk.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node scripts/check-built-package.mjs && node --test \"dist/test/**/*.js\"",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run check:package && npm test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@noble/ed25519": "3.1.0",
    "@noble/hashes": "2.2.0",
    "algosdk": "3.5.2"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "typescript": "5.9.3"
  }
}
